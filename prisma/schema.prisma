generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id
  email     String?   @unique
  plan      String    @default("free")
  planSince DateTime? @map("plan_since")
  createdAt DateTime  @default(now()) @map("created_at")

  // Prenumeration / entitlement.
  // plan: "free" | "premium" | "lifetime" (lifetime = grandfathad engångsköpare).
  // subProvider anger var det aktiva köpet kom ifrån: "stripe" (webb) eller "apple" (iOS/RevenueCat).
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  subProvider         String?   @map("sub_provider")
  subStatus           String?   @map("sub_status")
  subCurrentPeriodEnd DateTime? @map("sub_current_period_end")

  // Verifiering & login
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  lastLoginAt   DateTime? @map("last_login_at")

  /// Senaste tecknet på aktivitet (throttlad, ~1/min) — visas som "senast aktiv"
  /// på vänprofiler. Skild från lastLoginAt som bara sätts vid inloggning.
  lastActiveAt DateTime? @map("last_active_at")

  /// Senaste försöket att skicka dagens tips (app/api/cron/daily-recs).
  /// Kön sorteras på det här — den som väntat längst går först — så att inte
  /// samma användare hamnar sist varje körning när tidsbudgeten tar slut.
  /// null = har aldrig fått ett tips och går därför främst i kön.
  lastDailyRecAt DateTime? @map("last_daily_rec_at")

  /// Senast PUSHADE dagliga tipset. Utan interaktion är recs-listan stabil, så
  /// items[0] blev samma titel dag efter dag — cronen hoppar över den här.
  lastDailyRecTmdbId    Int?    @map("last_daily_rec_tmdb_id")
  lastDailyRecMediaType String? @map("last_daily_rec_media_type")

  /// När en recs-push FAKTISKT skickades. Skild från lastDailyRecAt med flit:
  /// den stämplas vid varje försök och styr bara köordningen, den här styr
  /// takten. Cron-schemat ligger kvar på dagligen (i Vercel-dashboarden, inte
  /// i repot) men cronen hoppar över den som fick en push för mindre än
  /// NW_REC_PUSH_MIN_HOURS sedan — 60 h landar på 2–3 pushar i veckan.
  lastRecPushSentAt DateTime? @map("last_rec_push_sent_at")

  /// Senaste "vi saknar dig"-pushen (Duolingo-stil) och vilken textvariant som
  /// användes. Varianten sparas enbart för att slippa samma skämt två gånger i
  /// rad — det är ingen statistikkolumn.
  lastReEngagementPushAt  DateTime? @map("last_re_engagement_push_at")
  lastReEngagementVariant String?   @map("last_re_engagement_variant")

  // Username för kompis-sök
  username String? @unique

  // Sign in with Apple (unikt Apple-användar-id)
  appleSub String? @unique @map("apple_sub")

  /// Refresh token från Apples /auth/token, sparad enbart för att kunna
  /// återkalla inloggningen vid kontoradering (Apple TN3194 + Guideline
  /// 5.1.1(v)). Null = tokenutbytet gick inte igenom eller kontot är äldre.
  appleRefreshToken String? @map("apple_refresh_token")

  /// När användaren godkände villkoren (Guideline 1.2 kräver att UGC-appar
  /// låter användare godkänna regler mot stötande innehåll).
  termsAcceptedAt DateTime? @map("terms_accepted_at")

  profile        Profile?
  ratings        Rating[]
  sharesSent     SharedTitle[] @relation("sharesSent")
  sharesReceived SharedTitle[] @relation("sharesReceived")
  watchlist      watchlist[]
  purchases      Purchase[]

  appleIapTransactions AppleIapTransaction[]

  // Groups
  groupMembers  GroupMember[] @relation("UserGroupMembers")
  groupsCreated Group[]       @relation("UserGroupsCreated")
  groupVotes    GroupVote[]   @relation("UserGroupVotes")

  // Friends
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  friendshipsAsUser      Friendship[]    @relation("FriendshipUser")
  friendshipsAsFriend    Friendship[]    @relation("FriendshipFriend")

  groupInvitesSent     GroupInvite[]    @relation("GroupInvitesFrom")
  groupInvitesReceived GroupInvite[]    @relation("GroupInvitesTo")
  groupMatchesSeen     GroupMatchSeen[]

  verifications   Verification[]
  pushTokens      PushToken[]
  onboardingTours OnboardingTour[]
  swipeBonuses    SwipeBonus[]
  releaseFollows  ReleaseFollow[]

  @@map("users")
}

/// Extra swipes intjänade via rewarded video (AdMob, iOS). En rad per tittad
/// video; lib/swipeLimit.ts summerar rader inom det rullande 24h-fönstret och
/// adderar till dagsgränsen. Beviljas server-side av /api/swipe/bonus (max 3
/// per rullande dygn) — klienten kan inte skriva hit direkt.
model SwipeBonus {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedAt], map: "idx_swipe_bonuses_user_granted")
  @@map("swipe_bonuses")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_push_tokens_user")
  @@map("push_tokens")
}

model Profile {
  userId           String   @id @map("user_id")
  dob              DateTime @db.Date
  uiLanguage       String   @default("sv") @map("ui_language")
  yearPreference   String   @default("all") @map("year_preference")
  recycleAfterDays Int      @default(14) @map("recycle_after_days")
  region           String   @default("SE")
  locale           String   @default("sv-SE")
  providers        Json     @default("[]")
  updatedAt        DateTime @default(now()) @map("updated_at")

  // Smakprofil
  displayName        String?  @map("display_name")
  /// Vald avatar ur det förvalda biblioteket (lib/avatars.ts), t.ex. "popcorn".
  /// Null = ingen vald (frivilligt val — UI faller tillbaka på initial).
  avatarId           String?  @map("avatar_id")
  favoriteMovie      Json?    @map("favorite_movie")
  favoriteShow       Json?    @map("favorite_show")
  favoriteGenres     String[] @default([]) @map("favorite_genres")
  dislikedGenres     String[] @default([]) @map("disliked_genres")
  /// Valda sub-genrer (TMDB keyword-id:n, se lib/subgenres.ts) för de gillade
  /// genrerna ovan. Tomt = ingen sub-genre-filtrering. Appliceras som HÅRT
  /// filter (with_keywords) i lib/unifiedRecs.ts för solo-läget, precis som
  /// Group.favoriteKeywordIds gör för grupper.
  favoriteKeywordIds Int[]    @default([]) @map("favorite_keyword_ids")
  /// Beteendebaserad genrestatistik, uppdateras vid varje swipe/betyg
  /// (lib/genreStats.ts): { "<tmdb-genre-id>": { "p": antal positiva, "n": antal
  /// negativa } }. Recs-pipelinen viktar genrer efter detta i stället för att
  /// blint lita på favoriteGenres — benchmarken 2026-08-14
  /// (docs/recs-benchmark-2026-08-14.md) visade att deklarerade genrer kan ha
  /// 76–88 % negativ swipe-andel. Null = ingen data än (ny användare).
  /// OBS: läses/skrivs med rå SQL tills klienten är omgenererad — se
  /// lib/genreStats.ts för varför.
  genreStats         Json?    @map("genre_stats")

  // Swipe-inställningar (styrs från profilen).
  /// Visa hyr-/köpalternativ på titelkort. Av som standard: annars tror användaren
  /// att titeln går att streama fritt och länkas till en betalsida.
  showPaidOptions  Boolean @default(false) @map("show_paid_options")
  /// movie | tv | both — vilken typ av titlar solo-swipen visar (standard: both).
  /// Grupper har sitt eget filter på Group.mediaFilter.
  swipeMediaFilter String  @default("both") @map("swipe_media_filter")
  /// Visa barn-/familjeinnehåll (TV-Kids-genren) i förslagen. Av som standard:
  /// vuxna vill sällan ha t.ex. My Little Pony i flödet. Se lib/unifiedRecs.ts.
  showKidsContent  Boolean @default(false) @map("show_kids_content")

  // Notisinställningar (per användare). Default: allt på.
  notifyDailyRecs      Boolean @default(true) @map("notify_daily_recs")
  notifyGroupMatches   Boolean @default(true) @map("notify_group_matches")
  notifyFriendRequests Boolean @default(true) @map("notify_friend_requests")
  notifyGroupInvites   Boolean @default(true) @map("notify_group_invites")
  /// Push när en vän skickar ett filmtips (filmchatten).
  notifyShares         Boolean @default(true) @map("notify_shares")
  notifyMarketing      Boolean @default(false) @map("notify_marketing")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Verification {
  token     String   @id
  userId    String   @map("user_id")
  email     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email], map: "idx_verifications_email")
  @@index([userId], map: "idx_verifications_user_id")
  @@map("verifications")
}

model Rating {
  id        String   @id
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  mediaType String   @map("media_type")
  rating    Int?
  decision  String   @default("RATED")
  decidedAt DateTime @default(now()) @map("decided_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Inget separat @@index på (userId, tmdbId, mediaType): @@unique ovan skapar
  // redan exakt det indexet. Dubbletten idx_ratings_user_tmdb låg här och hade
  // 0 scans i produktion medan unique-indexet stod för alla 2899 — den kostade
  // bara skrivtid och disk. Se prisma/sql/2026-07-15_daily_recs_fairness.sql.
  @@unique([userId, tmdbId, mediaType])
  @@map("ratings")
}

model watchlist {
  id        String   @id
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  mediaType String   @map("media_type")
  addedAt   DateTime @default(now()) @map("added_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@map("watchlist")
}

/// Cache för IMDb-betyg hämtade via OMDb (lib/omdbRating.ts) — fyller i
/// betyget OSYNLIGT när TMDB:s eget saknas eller är opålitligt (för få
/// röster). Global per titel (ingen userId): samma tmdbId+mediaType delas av
/// alla användare, så en enda OMDb-träff räcker för hela appen.
///
/// Cachade NOLLTRÄFFAR (titeln saknar IMDb-koppling, eller IMDb har inget
/// betyg alls) sparas OCKSÅ — annars skulle samma ratinglösa titel slå mot
/// OMDb:s 1000/dygn-gräns om och om igen. fetchedAt + TTL (30 dagar, se
/// EXTERNAL_RATING_TTL_MS i lib/omdbRating.ts) avgör när raden anses gammal
/// och slås upp igen.
model ExternalRating {
  tmdbId     Int      @map("tmdb_id")
  mediaType  String   @map("media_type")
  imdbId     String?  @map("imdb_id")
  imdbRating Float?   @map("imdb_rating")
  imdbVotes  Int?     @map("imdb_votes")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([tmdbId, mediaType])
  @@map("external_ratings")
}

/// Bevakning av en ännu OSLÄPPT titel. Skapas när användaren gillar ett
/// "Kommer snart"-kort i solo-swipen (se lib/upcomingTitles.ts): liken sparar
/// titeln i watchlist som vanligt OCH lägger en rad här. Cronen
/// (app/api/cron/daily-recs) sveper raderna och pushar när premiären passerat.
///
/// releaseDate är nullable med flit: TMDB har gott om titlar utan datum (TBA),
/// och de ska gå att följa ändå — cronens andra svep fyller på datumet i
/// efterhand när TMDB fått det. checkedAt håller det svepet rättvist (samma
/// mönster som User.lastDailyRecAt: den som kollades längst sedan går först),
/// annars hade samma 100 rader hämtats om varje körning.
model ReleaseFollow {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tmdbId      Int       @map("tmdb_id")
  mediaType   String    @map("media_type")
  title       String
  releaseDate DateTime? @map("release_date")
  /// Stämplas när släpp-notisen faktiskt gått iväg. null = bevakningen är aktiv.
  notifiedAt  DateTime? @map("notified_at")
  /// Senaste gången releaseDate slogs upp mot TMDB igen.
  checkedAt   DateTime? @map("checked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // En bevakning per titel och användare — gör om-liken (och ångra + swipa om)
  // idempotent via upsert.
  @@unique([userId, tmdbId, mediaType])
  // Cronens svep: "aktiva bevakningar vars premiär passerat". notifiedAt först
  // eftersom den filtrerar bort merparten av raderna (allt redan notifierat).
  @@index([notifiedAt, releaseDate], map: "idx_release_follows_notified_release")
  @@map("release_follows")
}

/// Filmtips mellan vänner ("chatten", omscopad): ett delat titelkort, ingen
/// fritext. Unik per (från, till, titel) — att tipsa om samma film igen bumpar
/// raden i stället för att spamma mottagarens inbox.
model SharedTitle {
  id         String    @id @default(cuid())
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  tmdbId     Int       @map("tmdb_id")
  mediaType  String    @map("media_type")
  title      String
  year       String?
  poster     String?
  /// När mottagaren öppnat tipset (null = oläst).
  seenAt     DateTime? @map("seen_at")
  /// Mottagarens fasta reaktion: "seen" (Redan sett) | "want" (Vill kolla) |
  /// "skip" (Vill inte se). Null = ingen reaktion än.
  reaction   String?
  createdAt  DateTime  @default(now()) @map("created_at")

  from User @relation("sharesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("sharesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, tmdbId, mediaType], map: "shared_titles_unique_tip")
  @@index([toUserId, createdAt], map: "idx_shared_titles_inbox")
  @@map("shared_titles")
}

model Purchase {
  id                    String   @id
  userId                String   @map("user_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amountTotal           Int      @default(0) @map("amount_total")
  currency              String   @default("SEK")
  product               String   @default("lifetime")
  createdAt             DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_purchases_user")
  @@map("purchases")
}

// Apple In-App Purchase-transaktioner (iOS). Idempotens: samma transactionId
// får aldrig ge premium två gånger. Motsvarar Stripe-webhookens roll för
// App Store-köp — se lib/appleIap.ts.
model AppleIapTransaction {
  transactionId String    @id @map("transaction_id")
  userId        String    @map("user_id")
  productId     String    @map("product_id")
  environment   String?
  purchasedAt   DateTime  @map("purchased_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_apple_iap_user")
  @@map("apple_iap_transactions")
}

/// Server-side "seen" state for interactive onboarding tours (lib/tours). Versioned
/// so a tour can be re-triggered for everyone by bumping its version in
/// lib/tours/registry.ts — old rows with a lower version count as unseen again.
/// Unlike the older localStorage coach-marks (lib/userGuide.ts), this persists
/// across devices/reinstalls, which the swipe-gesture tour needs to reach existing
/// users exactly once on next open, regardless of which device they open next.
model OnboardingTour {
  userId      String   @map("user_id")
  tourId      String   @map("tour_id")
  version     Int
  /// "completed" | "skipped"
  status      String   @default("completed")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tourId])
  @@map("onboarding_tours")
}

model Group {
  code      String   @id
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Gruppinställningar (kugghjulet, endast skaparen). Tomma/null = automatik:
  // genrer/providers unionas från medlemmarnas profiler, åldersgräns från
  // yngsta medlemmen och matchtröskeln är 60 % av gruppens storlek.
  // Se lib/groupSettings.ts.
  favoriteGenres     String[] @default([]) @map("favorite_genres")
  dislikedGenres     String[] @default([]) @map("disliked_genres")
  /// Valda sub-genrer (TMDB keyword-id:n, se lib/subgenres.ts) för de gillade
  /// genrerna ovan. Tomt = ingen sub-genre-filtrering. Appliceras som HÅRT
  /// filter (with_keywords) i lib/unifiedRecs.ts, precis som favoriteGenres.
  favoriteKeywordIds Int[]    @default([]) @map("favorite_keyword_ids")
  providers          Json     @default("[]")
  maxCert            String?  @map("max_cert")
  /// Antal PERSONER (≥2) som krävs för match. null = automatik (60 % av storlek).
  /// Klamras till aktuell gruppstorlek vid matchberäkning, se groupMatchNeed().
  matchThreshold     Int?     @map("match_threshold")
  /// movie | tv | both — vilken typ av titlar gruppen swipar (standard: both).
  mediaFilter        String   @default("both") @map("media_filter")

  members     GroupMember[]
  votes       GroupVote[]      @relation("GroupVotes")
  invites     GroupInvite[]
  matchesSeen GroupMatchSeen[]
  matches     GroupMatch[]

  creator User @relation("UserGroupsCreated", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("groups")
}

model GroupMember {
  groupCode String   @map("group_code")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupCode], references: [code], onDelete: Cascade)
  user  User  @relation("UserGroupMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupCode, userId])
  @@map("group_members")
}

model GroupVote {
  groupCode String   @map("group_code")
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  tmdbType  String   @map("tmdb_type")
  vote      String
  decidedAt DateTime @default(now()) @map("decided_at")

  group Group @relation("GroupVotes", fields: [groupCode], references: [code], onDelete: Cascade)
  user  User  @relation("UserGroupVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupCode, userId, tmdbId, tmdbType])
  @@index([groupCode, vote], map: "idx_group_votes_group_vote")
  @@map("group_votes")
}

model FriendRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  decidedAt  DateTime? @map("decided_at")

  fromUser User @relation("FriendRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId], map: "uq_friend_requests_pair")
  @@map("friend_requests")
}

model Friendship {
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@map("friendships")
}

model GroupInvite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupCode   String    @map("group_code")
  fromUserId  String    @map("from_user_id")
  toUserId    String    @map("to_user_id")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  // NEW: TTL för pending-invites (5 min)
  expiresAt DateTime? @map("expires_at")

  group    Group @relation(fields: [groupCode], references: [code], onDelete: Cascade)
  fromUser User  @relation("GroupInvitesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("GroupInvitesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  // Tillåt exakt en pending mellan två användare (oavsett grupp)
  @@unique([fromUserId, toUserId, status], map: "uq_group_invites_pair_status")
  @@map("group_invites")
}

model GroupMatchSeen {
  groupCode String   @map("group_code")
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  tmdbType  String   @map("tmdb_type")
  seenAt    DateTime @default(now()) @map("seen_at")

  group Group @relation(fields: [groupCode], references: [code], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupCode, userId, tmdbId, tmdbType])
  @@map("group_match_seen")
}

/// Historik över gruppens matchningar (Matchningar-fliken). Skrivs en gång per
/// titel, i samma stund som notifyGroupMatchIfNeeded() (lib/push.ts) upptäcker
/// att LIKE-antalet först når tröskeln — inte varje gång tröskeln räknas om.
model GroupMatch {
  groupCode String   @map("group_code")
  tmdbId    Int      @map("tmdb_id")
  tmdbType  String   @map("tmdb_type")
  matchedAt DateTime @default(now()) @map("matched_at")

  group Group @relation(fields: [groupCode], references: [code], onDelete: Cascade)

  @@id([groupCode, tmdbId, tmdbType])
  @@index([groupCode, matchedAt], map: "idx_group_matches_group_matched_at")
  @@map("group_matches")
}
